# SECURITY: this file is a LOCAL DEVELOPMENT template. Before deploying to
# production, you MUST explicitly set APP_ENV=production, APP_DEBUG=false,
# and SESSION_SECURE_COOKIE=true (below) — copying this file unedited to a
# live server exposes stack traces/SQL/env values to end users and sends
# session cookies over plain HTTP.
APP_NAME="CCTV Express Tacurong"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# On Hostinger, DB host/name/user are usually prefixed, e.g. host: localhost, name: u123456789_pos, user: u123456789_pos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_inventory_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once the site is served over HTTPS — left
# false/unset here only because local development is typically plain HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP. An earlier investigation concluded outbound SMTP from the web
# process was unreliable and switched to Resend's HTTP API instead — that
# was a misdiagnosis: the fixes were being verified against the wrong
# deployment directory (an unrelated manual clone, not the real Hostinger
# auto-deploy target), so nothing was ever actually confirmed against
# production's real .env. Once corrected, SMTP delivers reliably, including
# rapid repeated self-to-self sends and sends to third-party recipients —
# unlike Resend's free tier, which can ONLY send to the account owner's own
# address without verifying a domain, which silently breaks any notification
# addressed to someone other than the admin (e.g. a cashier).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: set these to control the password AdminUserSeeder/DatabaseSeeder
# assign to the demo Admin/Cashier accounts. Leave unset and the seeder
# generates and prints a random one instead — either way, no default
# password is ever hardcoded in source.
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_CASHIER_PASSWORD=
